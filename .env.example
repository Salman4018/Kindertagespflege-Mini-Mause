# Public Formspree endpoint. The form remains disabled while this is empty.
# This endpoint is public configuration, never place account credentials here.
VITE_FORM_ENDPOINT=https://formspree.io/f/FORM_ID

# Public origin and base path, always ending with a slash.
VITE_SITE_URL=https://example.invalid/

# Vite asset and route base. Use / locally or /REPOSITORY-NAME/ for GitHub Pages.
VITE_BASE_PATH=/
